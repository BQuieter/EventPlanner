<UserControl x:Class="EventPlannerClient.Views.EventCreate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:EventPlannerClient.Converters"
             xmlns:local="clr-namespace:EventPlannerClient.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ResourceDictionaries/Dark.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverterH x:Key="BoolToVisibility" IsReversed="False"/>
            <converters:BoolToVisibilityConverterH x:Key="BoolToVisibilityReversed" IsReversed="True"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#252525">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto" MinHeight="100"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Пользователь" Style="{StaticResource AuthorizeTextBlockStyle}"/>
            <TextBox Grid.Row="1" IsEnabled="False" Text="{Binding Login}" Style="{StaticResource AuthorizationTextBoxStyle}"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Время" Style="{StaticResource AuthorizeTextBlockStyle}"/>
            <TextBox Grid.Row="1" IsEnabled="{Binding IsOwner}" Text="{Binding TimeString}" Style="{StaticResource AuthorizationTextBoxStyle}"/>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Важность" Style="{StaticResource AuthorizeTextBlockStyle}"/>
            <ComboBox SelectedValue="{Binding Importance}" ItemContainerStyle="{StaticResource ComboBoxItemContainerStyle}" IsEnabled="{Binding IsOwner}" Style="{StaticResource ComboBoxStyle}" ItemsSource="{Binding ImportancesList}" IsEditable="False" Grid.Row="1" Width="200"/>
        </Grid>
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Описание" Style="{StaticResource AuthorizeTextBlockStyle}"/>
            <TextBox Grid.Row="1" TextWrapping="Wrap" MaxLines="10" MaxLength="200" MinHeight="80" Height="auto" Text="{Binding Description}" IsEnabled="{Binding IsOwner}" Style="{StaticResource AuthorizationTextBoxStyle}"/>
        </Grid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Width="100" Content="Создать" HorizontalAlignment="Right" Margin="0 0 20 0" Command="{Binding CreateCommand}" Visibility="{Binding IsCreated, Converter={StaticResource BoolToVisibilityReversed}}" Style="{StaticResource ButtonStyle}"/>
            <Button Grid.Column="1" Width="100" Content="Сбросить" HorizontalAlignment="Left" Margin="20 0 0 0" Command="{Binding ResetCommand}" Visibility="{Binding IsCreated, Converter={StaticResource BoolToVisibilityReversed}}" Style="{StaticResource ButtonStyle}"/>
        </Grid>
    </Grid>
</UserControl>

